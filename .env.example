# Local development only. Copy to .env and keep real credentials outside Git.
COMPOSE_PROJECT_NAME=fieldops

FIELDOPS_SERVER_PORT=8080
DEVICE_GATEWAY_PORT=8081
FIELDOPS_WEB_PORT=3000

POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=fieldops-local
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=fieldops-local

KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093

MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001

KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
TEMPO_HTTP_PORT=3200
LOKI_HTTP_PORT=3100

