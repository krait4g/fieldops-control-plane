# Web Console environment contract.
# NEXT_PUBLIC_FIELDOPS_DATA_MODE selects only the transport adapter: mock | remote.
# It contains no secret. Production build/runtime rejects "mock".
NEXT_PUBLIC_FIELDOPS_DATA_MODE=mock

# Server-only API origin used by the same-origin /api rewrite in remote mode.
# Must not contain credentials.
FIELDOPS_API_ORIGIN=http://localhost:8080