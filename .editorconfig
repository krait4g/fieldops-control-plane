root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt,kts,ts,tsx,js,mjs,cjs,json,yml,yaml,xml,properties,sql,md}]
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{gradle,kts}]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
